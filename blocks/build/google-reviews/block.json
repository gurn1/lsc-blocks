{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lsc-blocks/google-reviews",
  "version": "0.1.0",
  "title": "Google Reviews",
  "category": "widgets",
  "icon": "star-filled",
  "description": "Displays cached Google reviews for a configured business location.",
  "attributes": {
    "placeId": {
      "type": "string",
      "default": ""
    },
    "placeName": {
      "type": "string",
      "default": ""
    },
    "refreshInterval": {
      "type": "string",
      "default": "daily"
    },
    "displayMode": {
      "type": "string",
      "default": "list"
    },
    "slidesPerView": {
      "type": "number",
      "default": 1
    },
    "cardBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "cardTextColor": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "textdomain": "lsc-blocks",
  "viewScript": "file:./view.js",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}