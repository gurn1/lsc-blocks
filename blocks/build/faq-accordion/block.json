{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lsc-blocks/faq-accordion",
  "version": "0.1.0",
  "title": "FAQ Accordion",
  "category": "widgets",
  "icon": "editor-help",
  "description": "A list of expandable questions and answers, with schema.org markup for SEO.",
  "attributes": {
    "allowMultipleOpen": {
      "type": "boolean",
      "default": false
    },
    "categories": {
      "type": "array",
      "default": []
    },
    "textAlign": {
      "type": "string",
      "default": "left"
    },
    "itemSpacing": {
      "type": "number",
      "default": 16
    },
    "headingLevel": {
      "type": "number",
      "default": 3
    }
  },
  "providesContext": {
    "lsc-blocks/faqCategories": "categories",
    "lsc-blocks/faqHeadingLevel": "headingLevel"
  },
  "supports": {
    "html": false,
    "interactivity": true,
    "typography": {
      "fontSize": true,
      "fontFamily": true,
      "lineHeight": true
    },
    "color": {
      "text": true,
      "background": true
    }
  },
  "textdomain": "lsc-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScriptModule": "file:./view.js"
}